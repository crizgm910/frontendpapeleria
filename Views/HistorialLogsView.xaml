<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PapeleriaDB.Views.HistorialLogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:PapeleriaDB.Models" xmlns:viewmodels="clr-namespace:PapeleriaDB.ViewModels" mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1440" FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif">
  <UserControl.Resources>
    <!-- Colors -->
    <SolidColorBrush x:Key="BrandBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="BrandBlueLight" Color="#EFF6FF" />
    <SolidColorBrush x:Key="BrandBlueBorder" Color="#DBEAFE" />
    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BgLight" Color="#F9FAFB" />
    <!-- Base Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <!-- Menu Button Style -->
    <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="12,2">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BgLight}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueLight}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlinedButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Clean TextBox -->
    <Style x:Key="CleanTextBox" TargetType="TextBox">
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Clean DataGrid -->
    <Style x:Key="CleanDataGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="AlternatingRowBackground" Value="Transparent" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style x:Key="CleanDataGridColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="0,0,0,16" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="CleanDataGridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BgLight}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style x:Key="CleanDataGridCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Action Pill Badge -->
    <DataTemplate x:Key="ActionBadgeTemplate">
      <Border Background="Transparent" BorderBrush="{StaticResource BrandBlueBorder}" BorderThickness="1" CornerRadius="12" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="{Binding Accion}" Foreground="{StaticResource BrandBlue}" FontSize="12" FontWeight="SemiBold" />
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,24">
      <TextBlock Text="Historial (Logs)" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
      <TextBlock Text="Registro de todas las acciones del sistema." FontSize="15" Foreground="{StaticResource TextSecondary}" />
      <TextBlock Text="{Binding Mensaje}" FontSize="12" Foreground="#B45309" Margin="0,5,0,0" />
    </StackPanel>

    <!-- Main Logs Card -->
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" VerticalAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Search / Filters row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,24,24,0">
          <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Width="340" Height="40">
            <Grid Margin="12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="&#128269;" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
              <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" ToolTip="Buscar por usuario, acción o recurso"/>
            </Grid>
          </Border>
          
          <Button Style="{StaticResource OutlinedButton}" Margin="12,0,0,0" Height="40" Padding="16,0" Command="{Binding LoadCommand}">
            <StackPanel Orientation="Horizontal">
              <!-- Filter icon (Funnel) -->
              <TextBlock Text="&#9072;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
              <TextBlock Text="Actualizar" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          
          <Button Style="{StaticResource OutlinedButton}" Margin="12,0,0,0" Height="40" Padding="16,0" Command="{Binding ExportarCommand}">
            <StackPanel Orientation="Horizontal">
              <!-- Export icon (Tray/Download) -->
              <TextBlock Text="&#8681;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
              <TextBlock Text="Exportar" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" Style="{StaticResource CleanDataGrid}" ColumnHeaderStyle="{StaticResource CleanDataGridColumnHeader}" RowStyle="{StaticResource CleanDataGridRow}" CellStyle="{StaticResource CleanDataGridCell}" Margin="24,24,24,24" VerticalAlignment="Stretch">
          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="0.8*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="USUARIO" Binding="{Binding Usuario}" Width="1.5*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTemplateColumn Header="ACCIÓN" CellTemplate="{StaticResource ActionBadgeTemplate}" Width="1.5*" />

            <DataGridTextColumn Header="DETALLE" Binding="{Binding Detalles}" Width="2*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>

            <DataGridTextColumn Header="FECHA" Binding="{Binding Tiempo}" Width="1.5*">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
