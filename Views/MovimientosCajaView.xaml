<UserControl x:Class="PapeleriaDB.Views.MovimientosCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34" MaxWidth="1100" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="Ingresos y egresos" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Registra dinero adicional que entra o sale del cajón." Foreground="#6B7280" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Content="Actualizar" Command="{Binding LoadCommand}" HorizontalAlignment="Right" Padding="18,9"/>
            </Grid>

            <UniformGrid Columns="3" Margin="0,0,0,18">
                <Border Background="#172033" CornerRadius="14" Padding="20" Margin="0,0,10,0"><StackPanel><TextBlock Text="{Binding NombreCaja}" Foreground="#CBD5E1"/><TextBlock Text="{Binding EfectivoEsperado, StringFormat={}{0:C2}}" Foreground="White" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock Text="Efectivo esperado" Foreground="#CBD5E1" FontSize="12"/></StackPanel></Border>
                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="14" Padding="20" Margin="5,0"><StackPanel><TextBlock Text="Ingresos del turno" Foreground="#047857"/><TextBlock Text="{Binding IngresosTurno, StringFormat={}{0:C2}}" Foreground="#065F46" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="14" Padding="20" Margin="10,0,0,0"><StackPanel><TextBlock Text="Egresos del turno" Foreground="#B91C1C"/><TextBlock Text="{Binding EgresosTurno, StringFormat={}{0:C2}}" Foreground="#991B1B" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
            </UniformGrid>

            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0"><TextBlock Text="TIPO" Foreground="#6B7280" FontSize="11" FontWeight="Bold" Margin="0,0,0,7"/><ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSeleccionado}" Height="44" Padding="10,6"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="MONTO" Foreground="#6B7280" FontSize="11" FontWeight="Bold" Margin="0,0,0,7"/><TextBox Text="{Binding MontoTexto, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="12,8"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,14,0"><TextBlock Text="MOTIVO" Foreground="#6B7280" FontSize="11" FontWeight="Bold" Margin="0,0,0,7"/><TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Height="44" Padding="12,8"/></StackPanel>
                    <Button Grid.Column="3" Content="Registrar movimiento" Command="{Binding RegistrarCommand}" VerticalAlignment="Bottom" Height="44" Padding="20,8" Background="#7E22CE" Foreground="White" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding Mensaje}" Foreground="#B45309" Margin="2,0,0,14" TextWrapping="Wrap"/>
            <TextBlock Text="Movimientos recientes" FontSize="19" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,10"/>
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="16">
                <DataGrid ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FECHA" Binding="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="1.5*"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="1*"/>
                        <DataGridTextColumn Header="MOTIVO" Binding="{Binding Motivo}" Width="3*"/>
                        <DataGridTextColumn Header="MONTO" Binding="{Binding Monto, StringFormat={}{0:C2}}" Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
