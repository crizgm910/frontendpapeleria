<UserControl x:Class="PapeleriaDB.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1440"
             FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif">
             
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Colors -->
        <SolidColorBrush x:Key="BrandBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="BrandBlueLight" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BgLight" Color="#F9FAFB"/>
        
        <!-- Menu Button Style -->
        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="12,4">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgLight}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Removed MenuToggleStyle and SubMenuButtonStyle -->
    </UserControl.Resources>

    <Grid Background="{StaticResource BgLight}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <!-- Fix 3 applied: No bottom profile row needed anymore -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo Section -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,24,24,32">
                    <Border Width="36" Height="36" Background="{StaticResource BrandBlue}" CornerRadius="8">
                        <TextBlock Text="&#128214;" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Papeler&#237;a DB" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Punto de Venta" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Panel / Resumen -->
                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="PanelResumen" IsChecked="True" GroupName="Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#9883;" FontSize="16" Foreground="{StaticResource BrandBlue}" Margin="0,0,12,0"/>
                                <TextBlock Text="Panel / Resumen" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandBlue}"/>
                            </StackPanel>
                        </RadioButton>
                        
                        <!-- Ventas / POS (NavegaciÃ³n directa al historial) -->
                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="HistorialVentas" GroupName="Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#128182;" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                <TextBlock Text="Ventas / POS" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Servicios -->
                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Servicios" GroupName="Menu">
                            <Grid Width="210">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#128424;" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Servicios" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                                <Border Background="#FBBF24" CornerRadius="10" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalServicios}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- CatÃ¡logo -->
                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Catalogo" GroupName="Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#128230;" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                <TextBlock Text="Cat&#225;logo" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Ingreso de Stock -->
                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="IngresoStock" GroupName="Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#128229;" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                <TextBlock Text="Ingreso de Stock" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Historial Logs -->
                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="CorteCaja" GroupName="Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#128179;" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                <TextBlock Text="Corte de caja" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="MovimientosCaja" GroupName="Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↕" FontSize="18" Width="28" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text="Ingresos y egresos" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Historial Logs -->
                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="HistorialLogs" GroupName="Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#128338;" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                <TextBlock Text="Historial (Logs)" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- ConfiguraciÃ³n -->
                        <RadioButton Style="{StaticResource MenuButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Configuracion" GroupName="Menu">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#9881;" FontSize="16" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                <TextBlock Text="Configuraci&#243;n" FontWeight="Medium" FontSize="14" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP NAVBAR -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid Margin="32,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Column="0" Background="{StaticResource BgLight}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Height="40" HorizontalAlignment="Left" Width="400">
                        <StackPanel Orientation="Horizontal" Margin="12,0">
                            <TextBlock Text="&#128269;" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="14"/>
                            <TextBlock Text="Buscar ventas, productos, servicios..." Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <!-- Top Right Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Notification Bell -->
                        <!-- Fix 4 applied: Gear Icon removed next to notification bell -->
                        <Grid Margin="0,0,24,0">
                            <Border Width="36" Height="36" CornerRadius="18" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Background="White">
                                <TextBlock Text="&#128276;" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Width="8" Height="8" Background="#F59E0B" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"/>
                        </Grid>
                        
                        <!-- Mini Profile Dropdown -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" Background="{StaticResource BrandBlue}" CornerRadius="16">
                                <TextBlock Text="C1" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="Cajero 1" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Turno Matutino" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <TextBlock Text="&#709;" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DYAMIC CONTENT INJECTED HERE -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}">
                <ContentControl.Resources>
                    <Style TargetType="UserControl">
                        <Setter Property="RenderTransform">
                            <Setter.Value>
                                <TranslateTransform Y="20" />
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
