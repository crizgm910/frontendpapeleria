<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PapeleriaDB.Views.NuevaVentaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:PapeleriaDB.Models" xmlns:viewmodels="clr-namespace:PapeleriaDB.ViewModels" mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1440" FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif">
  <UserControl.Resources>
    <!-- Colors -->
    <SolidColorBrush x:Key="BrandBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="BrandBlueLight" Color="#EFF6FF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BgLight" Color="#F9FAFB" />
    <SolidColorBrush x:Key="SuccessButton" Color="#047857" />
    <SolidColorBrush x:Key="SuccessText" Color="#059669" />
    <SolidColorBrush x:Key="SuccessBg" Color="#ECFDF5" />
    <SolidColorBrush x:Key="WarningText" Color="#D97706" />
    <!-- Base Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!-- Menu Styles -->
    <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="12,2">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BgLight}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueLight}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SubMenuButtonStyle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="36,10,12,10" Margin="12,2">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BgLight}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Button Styles -->
    <Style x:Key="OutlinedButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SolidGreenButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource SuccessButton}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlinedButtonBlue" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource BrandBlue}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandBlueLight}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlinedButtonYellow" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource WarningText}" />
      <Setter Property="BorderBrush" Value="#FEF3C7" />
      <!-- Light yellow border -->
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Clean TextBox -->
    <Style x:Key="CleanTextBox" TargetType="TextBox">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Clean DataGrid -->
    <Style x:Key="CleanDataGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="AlternatingRowBackground" Value="Transparent" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style x:Key="CleanDataGridColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="0,0,0,16" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="CleanDataGridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BgLight}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style x:Key="CleanDataGridCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Toggle Button for Payment Methods -->
    <Style x:Key="PaymentToggle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="16,8" Margin="0,0,8,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource SuccessBg}" />
                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SuccessText}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Content templates for item descriptions with conditional icon -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <DataTemplate x:Key="ProductCellTemplate">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#128438;" Foreground="{StaticResource WarningText}" Margin="0,0,8,0" Visibility="{Binding IsServicio, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
      <!-- Header -->
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Nueva venta" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
          <TextBlock Text="Registra una venta o servicio en el punto de venta." FontSize="15" Foreground="{StaticResource TextSecondary}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource OutlinedButton}" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2715;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Cancelar" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SolidGreenButton}" Command="{Binding RegistrarVentaCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#x2714;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Registrar venta" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <!-- Split layout for POS -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.2*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <!-- Left Column (Cart / Client) -->
        <StackPanel Grid.Column="0" Margin="0,0,24,0">
          <!-- Datos del Cliente -->
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="Datos del cliente (opcional)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
              <TextBlock Text="Puedes dejar estos campos vac&#237;os para una venta a p&#250;blico general."
                         Foreground="{StaticResource TextMuted}" Margin="0,0,0,16" />
              <TextBox Style="{StaticResource CleanTextBox}" Text="Nombre del cliente (opcional)" Margin="0,0,0,16" Foreground="{StaticResource TextMuted}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource CleanTextBox}" Text="N&#250;mero de tel&#233;fono (opcional)" Margin="0,0,16,0" Foreground="{StaticResource TextMuted}" />
                <TextBox Grid.Column="1" Style="{StaticResource CleanTextBox}" Text="RFC para factura (opcional)" Foreground="{StaticResource TextMuted}" />
              </Grid>
            </StackPanel>
          </Border>
          <!-- Productos y Servicios -->
          <Border Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <!-- Card Header -->
              <Grid Grid.Row="0" Margin="24">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Productos y Servicios" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button Style="{StaticResource OutlinedButtonYellow}" Margin="0,0,12,0">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4BC;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Servicio" FontSize="13" VerticalAlignment="Center" />
                      </StackPanel>
                  </Button>
                  <Button Style="{StaticResource OutlinedButtonBlue}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F4E6;" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Producto" FontSize="13" VerticalAlignment="Center" />
                      </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
              <!-- Search Product -->
              <TextBox Grid.Row="1" Style="{StaticResource CleanTextBox}" Text="Escanear cÃ³digo de barras o buscar producto..." Margin="24,0,24,24" Foreground="{StaticResource TextMuted}" />
              <!-- DataGrid -->
              <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" Style="{StaticResource CleanDataGrid}" ColumnHeaderStyle="{StaticResource CleanDataGridColumnHeader}" RowStyle="{StaticResource CleanDataGridRow}" CellStyle="{StaticResource CleanDataGridCell}" Margin="24,0,24,24">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="PRODUCTO / SERVICIO" Width="3*" CellTemplate="{StaticResource ProductCellTemplate}" />
                  <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.5*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="PRECIO" Binding="{Binding Precio, StringFormat=\{0:C\}}" Width="1*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad}" Width="1*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="SUBTOTAL" Binding="{Binding Subtotal, StringFormat=\{0:C\}}" Width="1.2*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        <Setter Property="FontWeight" Value="Bold" />
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </StackPanel>
        <!-- Right Column (Resumen & Pago) -->
        <StackPanel Grid.Column="1">
          <!-- Resumen Card -->
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="Resumen" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
              <Grid Margin="0,0,0,12">
                <TextBlock Text="Subtotal" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left" />
                <TextBlock Text="$137.50" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
              </Grid>
              <Grid Margin="0,0,0,12">
                <TextBlock Text="Descuento" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left" />
                <TextBlock Text="$0.00" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
              </Grid>
              <Grid Margin="0,0,0,24">
                <TextBlock Text="IVA (16%)" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left" />
                <TextBlock Text="$22.00" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right" />
              </Grid>
              <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,0,0,24" />
              <Grid>
                <TextBlock Text="Total" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock Text="$159.50" FontWeight="Bold" FontSize="28" Foreground="{StaticResource BrandBlue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>
          <!-- MÃ©todo de pago Card -->
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="MÃ©todo de pago" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
              <WrapPanel Margin="0,0,0,24">
                <RadioButton Style="{StaticResource PaymentToggle}" IsChecked="True" GroupName="Payment">
                  <TextBlock Text="Efectivo">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SuccessText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource PaymentToggle}" GroupName="Payment">
                  <TextBlock Text="Tarjeta" Foreground="{StaticResource TextSecondary}" />
                </RadioButton>
                <RadioButton Style="{StaticResource PaymentToggle}" GroupName="Payment">
                  <TextBlock Text="Transfer." Foreground="{StaticResource TextSecondary}" />
                </RadioButton>
              </WrapPanel>
              <TextBox Style="{StaticResource CleanTextBox}" Text="Monto recibido" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
