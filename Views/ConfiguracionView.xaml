<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PapeleriaDB.Views.ConfiguracionView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:PapeleriaDB.ViewModels" mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1440" FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <!-- Colors -->
    <SolidColorBrush x:Key="BrandBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="BrandBlueLight" Color="#EFF6FF" />
    <SolidColorBrush x:Key="BrandBlueBorder" Color="#DBEAFE" />
    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BgLight" Color="#F9FAFB" />
    <SolidColorBrush x:Key="DangerBg" Color="#FEF2F2" />
    <SolidColorBrush x:Key="DangerBorder" Color="#FECACA" />
    <SolidColorBrush x:Key="DangerText" Color="#EF4444" />
    <!-- Base Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
    </Style>
    <!-- Menu Button Style -->
    <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="12,2">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BgLight}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueLight}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlinedButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlinedButtonDanger" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource DangerText}" />
      <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerBg}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlinedButtonBlue" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource BrandBlue}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandBlueBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueLight}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SolidButtonBlue" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BrandBlue}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="24,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Clean TextBox -->
    <Style x:Key="CleanTextBox" TargetType="TextBox">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="{StaticResource BgLight}" />
          <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
      <!-- Header -->
      <StackPanel Margin="0,0,0,24">
        <TextBlock Text="Configuraci&#243;n" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
        <TextBlock Text="Gestiona tu cuenta y preferencias del sistema." FontSize="15" Foreground="{StaticResource TextSecondary}" />
      </StackPanel>

      <!-- Profile Card (Full Width) -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          
          <Border Grid.Column="0" Width="64" Height="64" Background="{StaticResource BrandBlue}" CornerRadius="32" Margin="0,0,24,0">
            <TextBlock Text="C1" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Cajero 1" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="cajero1@papeleriadb.local" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <Border Background="{StaticResource BrandBlueLight}" BorderBrush="{StaticResource BrandBlueBorder}" BorderThickness="1" CornerRadius="12" Padding="12,4">
                <TextBlock Text="Rol: Cajero" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" />
              </Border>
            </StackPanel>
          </StackPanel>
          
          <Button Grid.Column="2" Style="{StaticResource OutlinedButtonDanger}" VerticalAlignment="Center"
                  Command="{Binding CerrarSesionCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Cerrar Sesi&#243;n" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Caja principal compartida por todas las computadoras -->
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="1.3*" />
            <ColumnDefinition Width="0.8*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock Text="CAJA PRINCIPAL COMPARTIDA" Style="{StaticResource LabelStyle}" />
            <ComboBox ItemsSource="{Binding CajasDisponibles}"
                      SelectedItem="{Binding CajaSeleccionada}"
                      DisplayMemberPath="Descripcion"
                      IsEnabled="False"
                      MinHeight="44" Padding="12,8" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,24,0">
            <TextBlock Text="NOMBRE DE LA COMPUTADORA" Style="{StaticResource LabelStyle}" />
            <TextBox Text="{Binding TerminalId, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource CleanTextBox}" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="EFECTIVO INICIAL" Style="{StaticResource LabelStyle}" />
            <TextBox Text="{Binding MontoInicial, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                     Style="{StaticResource CleanTextBox}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Top">
          <Button Content="Guardar computadora"
                  Command="{Binding GuardarConfiguracionCommand}"
                  Style="{StaticResource SolidButtonBlue}"
                  MinHeight="44" Margin="0,0,8,0" />
          <Button Content="Abrir caja"
                  Command="{Binding AbrirCajaCommand}"
                  Style="{StaticResource OutlinedButtonBlue}"
                  IsEnabled="{Binding PuedeAbrirCaja}"
                  MinHeight="44" Margin="0,0,8,0" />
          <Button Content="Cerrar caja"
                  Command="{Binding IrACerrarCajaCommand}"
                  Style="{StaticResource OutlinedButtonDanger}"
                  Visibility="{Binding CajaEstaAbierta, Converter={StaticResource BoolToVisibility}}"
                  MinHeight="44" />
          </StackPanel>
          <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding EstadoConfiguracion}"
                     Foreground="{StaticResource TextSecondary}" Margin="0,14,0,0" TextWrapping="Wrap" />
        </Grid>
      </Border>

      <!-- 2 Columns Layout -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        
        <!-- Información de la cuenta -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,24,0">
          <StackPanel>
            <TextBlock Text="Informaci&#243;n de la Cuenta" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
            
            <TextBlock Style="{StaticResource LabelStyle}" Text="ID OPERADOR" />
            <TextBox Style="{StaticResource CleanTextBox}" Text="OPR-2026-001 (No modificable)" IsEnabled="False" Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource LabelStyle}" Text="ROL / CARGO" />
            <TextBox Style="{StaticResource CleanTextBox}" Text="Cajero" IsEnabled="False" Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource LabelStyle}" Text="USUARIO DE ACCESO" />
            <TextBox Style="{StaticResource CleanTextBox}" Text="cajero1@papeleriadb.local" IsEnabled="False" Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource LabelStyle}" Text="PIN DE TURNO (EDITABLE)" Foreground="{StaticResource BrandBlue}" />
            <Grid Margin="0,0,0,24">
              <TextBox Style="{StaticResource CleanTextBox}" BorderBrush="{StaticResource BrandBlue}" Text="&#8226;&#8226;&#8226;&#8226;" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
              <TextBlock Text="&#9998;" Foreground="{StaticResource BrandBlue}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
            </Grid>

            <Button Style="{StaticResource SolidButtonBlue}" HorizontalAlignment="Left" Padding="24,10">
               <TextBlock Text="Guardar cambios" FontSize="14" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Columna Derecha (Seguridad y Consola) -->
        <StackPanel Grid.Column="1">
          
          <!-- Seguridad y Credenciales -->
          <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
            <StackPanel>
              <TextBlock Text="Seguridad y Credenciales" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
              
              <TextBlock Style="{StaticResource LabelStyle}" Text="CONTRASE&#209;A DE ACCESO" />
              <TextBlock Text="Contrase&#241;a activa: &#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
              <TextBlock Text="&#218;ltima actualizaci&#243;n: hace 3 meses" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,16" />
              
              <Button Style="{StaticResource OutlinedButtonBlue}" HorizontalAlignment="Left">
                 <TextBlock Text="Cambiar contrase&#241;a" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Consola de Administracion -->
          <Border Style="{StaticResource CardStyle}">
            <Grid>
              <!-- The background content is blurred/hidden -->
              <StackPanel Opacity="0.05">
                <TextBlock Text="Consola de Administraci&#243;n" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
                <TextBlock Text="Respaldar Base de Datos" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
                <Button Style="{StaticResource OutlinedButtonBlue}" Content="Descargar Respaldo" HorizontalAlignment="Left" />
              </StackPanel>

              <!-- Overlay Message -->
              <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="24,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#128274;" FontSize="16" Foreground="{StaticResource DangerText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock Text="Requiere Rol: Administrador" FontSize="14" FontWeight="Bold" Foreground="{StaticResource DangerText}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
