<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PapeleriaDB.Views.IngresoDeStockView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:PapeleriaDB.Models" xmlns:viewmodels="clr-namespace:PapeleriaDB.ViewModels" mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1440" FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif">
  <UserControl.Resources>
    <!-- Colors -->
    <SolidColorBrush x:Key="BrandBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="BrandBlueLight" Color="#EFF6FF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BgLight" Color="#F9FAFB" />
    <SolidColorBrush x:Key="SuccessBg" Color="#ECFDF5" />
    <SolidColorBrush x:Key="SuccessText" Color="#059669" />
    <SolidColorBrush x:Key="SuccessButton" Color="#047857" />
    <SolidColorBrush x:Key="WarningBg" Color="#FFFBEB" />
    <SolidColorBrush x:Key="WarningBorder" Color="#FDE68A" />
    <SolidColorBrush x:Key="WarningText" Color="#D97706" />
    <!-- Base Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!-- Menu Button Style -->
    <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="12,2">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BgLight}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueLight}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Clean DataGrid -->
    <Style x:Key="CleanDataGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="AlternatingRowBackground" Value="Transparent" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style x:Key="CleanDataGridColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="0,0,0,16" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="CleanDataGridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BgLight}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style x:Key="CleanDataGridCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlinedButtonBlue" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource BrandBlue}" />
      <Setter Property="BorderBrush" Value="{StaticResource BrandBlueLight}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SolidGreenButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource SuccessButton}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CleanTextBox" TargetType="TextBox">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="6">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
      <!-- Header -->
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Ingreso de Stock" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
          <TextBlock Text="Registra entradas de inventario y actualiza existencias." FontSize="15" Foreground="{StaticResource TextSecondary}" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource SolidGreenButton}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="?" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="Guardar ingreso" FontSize="14" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <!-- Top Cards -->
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <!-- Left: Datos del ingreso -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,24,0">
          <StackPanel>
            <TextBlock Text="Datos del ingreso" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Folio" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Style="{StaticResource CleanTextBox}" Text="{Binding Folio}" IsReadOnly="True" Background="{StaticResource BgLight}" />
            </Grid>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Proveedor" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
              <!-- Using TextBox for mockup, in real world it's a ComboBox -->
              <TextBox Grid.Column="1" Style="{StaticResource CleanTextBox}" Text="{Binding Proveedor}" />
            </Grid>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Fecha" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Style="{StaticResource CleanTextBox}" Text="{Binding Fecha}" />
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Responsable" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Style="{StaticResource CleanTextBox}" Text="{Binding Responsable}" />
            </Grid>
          </StackPanel>
        </Border>
        <!-- Right: Resumen del movimiento -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
          <StackPanel>
            <TextBlock Text="Resumen del movimiento" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <!-- Blue Box -->
              <Border Grid.Column="0" Background="{StaticResource BrandBlueLight}" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                <StackPanel>
                  <TextBlock Text="Art&#237;culos en entrada" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" Margin="0,0,0,8" />
                  <TextBlock Text="4" FontSize="32" FontWeight="Bold" Foreground="{StaticResource BrandBlue}" Margin="0,0,0,4" />
                  <TextBlock Text="en este ingreso" FontSize="12" Foreground="{StaticResource BrandBlue}" />
                </StackPanel>
              </Border>
              <!-- Green Box -->
              <Border Grid.Column="1" Background="{StaticResource SuccessBg}" CornerRadius="8" Padding="16">
                <StackPanel>
                  <TextBlock Text="Unidades totales" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessText}" Margin="0,0,0,8" />
                  <TextBlock Text="710" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessText}" Margin="0,0,0,4" />
                  <TextBlock Text="pendientes de confirmar" FontSize="12" Foreground="{StaticResource SuccessText}" />
                </StackPanel>
              </Border>
            </Grid>
            <!-- Yellow Alert -->
            <Border Background="{StaticResource WarningBg}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,24,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="?" FontSize="16" Foreground="{StaticResource WarningText}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Validar que los SKUs coincidan antes de guardar." FontSize="13" Foreground="{StaticResource WarningText}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
      <!-- Articulos del Ingreso DataGrid Card -->
      <Border Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <!-- Search & Add Row Bar inside Card -->
          <Grid Grid.Row="0" Margin="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Artículos del ingreso" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
            <Border Grid.Column="2" Width="260" Height="40" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,16,0">
              <StackPanel Orientation="Horizontal" Margin="12,0">
                <TextBlock Text="??" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" FontSize="14" />
                <TextBlock Text="Buscar por código o nombre" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13" />
              </StackPanel>
            </Border>
            <Button Grid.Column="3" Style="{StaticResource OutlinedButtonBlue}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="+" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="Agregar fila" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" />
          <!-- DataGrid -->
          <DataGrid Grid.Row="2" ItemsSource="{Binding Articulos}" Style="{StaticResource CleanDataGrid}" ColumnHeaderStyle="{StaticResource CleanDataGridColumnHeader}" RowStyle="{StaticResource CleanDataGridRow}" CellStyle="{StaticResource CleanDataGridCell}" Margin="24,16,24,24">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ARTÍCULO" Binding="{Binding Nombre}" Width="3*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                    <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="STOCK ACTUAL" Binding="{Binding StockActual}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <!-- Added '+ ' to Cantidad Entrada -->
              <DataGridTextColumn Header="CANTIDAD ENTRADA" Binding="{Binding CantidadEntrada, StringFormat='+{0}'}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource SuccessText}" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="NUEVO STOCK" Binding="{Binding NuevoStock}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="ACCIONES" Width="1*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="…" Foreground="{StaticResource TextMuted}" FontSize="16" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand" />
                      <TextBlock Text="??" Foreground="{StaticResource TextMuted}" FontSize="16" Cursor="Hand" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
