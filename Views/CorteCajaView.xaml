<UserControl x:Class="PapeleriaDB.Views.CorteCajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="850" d:DesignWidth="1180"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <SolidColorBrush x:Key="Primary" Color="#2563EB"/>
        <SolidColorBrush x:Key="Text" Color="#111827"/>
        <SolidColorBrush x:Key="Muted" Color="#6B7280"/>
        <SolidColorBrush x:Key="Border" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Background" Color="#F8FAFC"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="22"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Padding" Value="24,11"/>
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{StaticResource Background}">
            <StackPanel Margin="36,30,36,44" MaxWidth="1050" HorizontalAlignment="Left">
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Corte de caja" FontSize="29" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Cuenta el efectivo y revisa la diferencia antes de cerrar el turno." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Actualizar" Command="{Binding CargarCommand}" MinWidth="120" MinHeight="44" Padding="18,9"/>
                </Grid>

                <Border Style="{StaticResource Card}" Background="#172033" BorderThickness="0" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding NombreCaja}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding EstadoCaja}" Foreground="#CBD5E1" FontSize="13" Margin="0,5,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Efectivo esperado" Foreground="#CBD5E1" FontSize="13" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding EfectivoEsperado, StringFormat={}{0:C2}}" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Ventas en efectivo" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding VentasEfectivo, StringFormat={}{0:C2}}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel><TextBlock Text="Tarjeta y transferencia" Foreground="{StaticResource Muted}"/><TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,5,0,0"><Run Text="{Binding VentasTarjeta, StringFormat={}{0:C2}}"/><Run Text=" / "/><Run Text="{Binding VentasTransferencia, StringFormat={}{0:C2}}"/></TextBlock></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="Ingresos / egresos" Foreground="{StaticResource Muted}"/><TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,5,0,0"><Run Text="{Binding IngresosExtra, StringFormat=+{0:C2}}"/><Run Text=" / "/><Run Text="{Binding Egresos, StringFormat=-{0:C2}}"/></TextBlock></StackPanel></Border>
                </UniformGrid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="Efectivo contado" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                            <TextBlock Text="Cuenta únicamente billetes y monedas del cajón." Foreground="{StaticResource Muted}" Margin="0,4,0,12"/>
                            <TextBox Text="{Binding EfectivoContadoTexto, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" FontSize="20" Padding="12,8" IsEnabled="{Binding PuedeCerrar}"/>
                            <CheckBox IsChecked="{Binding ConfirmarCorte}" IsEnabled="{Binding PuedeCerrar}" Margin="0,15,0,0" FontSize="14" Content="Confirmo que terminé de contar el efectivo"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="12" Padding="18">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DiferenciaDescripcion}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding DiferenciaPrevia, StringFormat={}{0:C2}}" Foreground="{StaticResource Primary}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Mensaje}" Foreground="#B45309" FontSize="14" TextWrapping="Wrap" Margin="2,0,0,12"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Cerrar turno y guardar corte" Command="{Binding CerrarCommand}" IsEnabled="{Binding PuedeCerrar}" HorizontalAlignment="Left" MinWidth="270"/>

                <Border Style="{StaticResource Card}" Background="#ECFDF5" BorderBrush="#A7F3D0" Margin="0,18,0,0" Visibility="{Binding ResultadoVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Corte guardado" Foreground="#047857" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Text}"><Run Text="Esperado: "/><Run Text="{Binding ResultadoEsperado, StringFormat={}{0:C2}}"/><Run Text=" · Diferencia: "/><Run Text="{Binding ResultadoDiferencia, StringFormat={}{0:C2}}"/><Run Text=" · Tarjeta: "/><Run Text="{Binding ResultadoTarjeta, StringFormat={}{0:C2}}"/></TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Cortes recientes" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,28,0,12"/>
                <ItemsControl ItemsSource="{Binding Historial}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,9" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding FechaCierre, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontWeight="SemiBold"/><TextBlock Text="{Binding Usuario}" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="28,0"><TextBlock Text="Esperado" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding EfectivoEsperado, StringFormat={}{0:C2}}" FontWeight="SemiBold"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Diferencia" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Diferencia, StringFormat={}{0:C2}}" FontWeight="Bold"/></StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
