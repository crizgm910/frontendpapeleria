<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PapeleriaDB.Views.InventarioView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:PapeleriaDB.Models" xmlns:viewmodels="clr-namespace:PapeleriaDB.ViewModels" mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1440" FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif">
  <UserControl.Resources>
    <!-- Colors -->
    <SolidColorBrush x:Key="BrandBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="BrandBlueLight" Color="#EFF6FF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BgLight" Color="#F9FAFB" />
    <SolidColorBrush x:Key="SuccessBg" Color="#D1FAE5" />
    <SolidColorBrush x:Key="SuccessText" Color="#059669" />
    <SolidColorBrush x:Key="WarningBg" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarningText" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBg" Color="#FEE2E2" />
    <SolidColorBrush x:Key="DangerText" Color="#EF4444" />
    <!-- Base Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!-- Menu Button Style -->
    <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="12,2">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BgLight}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueLight}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Status Badge Style -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Activo">
          <Setter Property="Background" Value="{StaticResource SuccessBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Bajo stock">
          <Setter Property="Background" Value="{StaticResource WarningBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Sin stock">
          <Setter Property="Background" Value="{StaticResource DangerBg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Activo">
          <Setter Property="Foreground" Value="{StaticResource SuccessText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Bajo stock">
          <Setter Property="Foreground" Value="{StaticResource WarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Sin stock">
          <Setter Property="Foreground" Value="{StaticResource DangerText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Clean DataGrid -->
    <Style x:Key="CleanDataGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="AlternatingRowBackground" Value="Transparent" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style x:Key="CleanDataGridColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="0,0,0,16" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="CleanDataGridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BgLight}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="MinHeight" Value="64" />
    </Style>
    <Style x:Key="CleanDataGridCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="OutlinedButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BrandBlue}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
      <!-- Header -->
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="CatÃ¡logo de Productos" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
          <TextBlock Text="Gestiona artÃ­culos, categorÃ­as, precios y existencias." FontSize="15" Foreground="{StaticResource TextSecondary}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource OutlinedButton}" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="â‡«" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Importar" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="+" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="Nuevo artÃ­culo" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
      <!-- Main Catalog Card -->
      <Border Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <!-- Search & Filter Bar inside Card -->
          <Grid Grid.Row="0" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cuadro de texto real con placeholders -->
            <TextBox Grid.Column="0" 
                     
                     Tag="Buscar art&#237;culo, SKU o categor&#237;a..."
                     Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,12,0"/>

            <!-- BotÃ³n Filtros funcional -->
            <Button Grid.Column="1" 
                    Command="{Binding AlternarFiltrosCommand}"
                    Height="40" 
                    Padding="16,0"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#x23f7;" Margin="0,0,8,0" VerticalAlignment="Center"/> <!-- Icono flecha abajo -->
                                <TextBlock Text="Filtros" FontWeight="Medium" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
          </Grid>
          <Border Grid.Row="1" Height="1" Background="{StaticResource BorderColor}" />
          <!-- DataGrid -->
          <DataGrid Grid.Row="2" ItemsSource="{Binding ArticulosView}" Style="{StaticResource CleanDataGrid}" ColumnHeaderStyle="{StaticResource CleanDataGridColumnHeader}" RowStyle="{StaticResource CleanDataGridRow}" CellStyle="{StaticResource CleanDataGridCell}" Margin="24,16,24,24">
            <DataGrid.Columns>
              <DataGridTextColumn Header="ARTÃCULO" Binding="{Binding Nombre}" Width="3*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="14" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                    <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="CATEGORÃA" Binding="{Binding Categoria}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="PRECIO" Binding="{Binding Precio, StringFormat=\{0:C\}}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="Medium" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="STOCK" Binding="{Binding Stock}" Width="1*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="ESTADO" Width="1.5*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource StatusBadgeStyle}">
                      <TextBlock Text="{Binding Estado}" Style="{StaticResource StatusTextStyle}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="ACCIONES" Width="1*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="â€¦" Foreground="{StaticResource TextMuted}" FontSize="16" FontWeight="Bold" Margin="0,0,12,0" Cursor="Hand" />
                      <TextBlock Text="ðŸ‘" Foreground="{StaticResource TextMuted}" FontSize="16" Cursor="Hand" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <!-- Bottom Section: Quick Categories -->
          <Grid Grid.Row="3" Background="{StaticResource BgLight}" Margin="0">
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderColor}" Padding="24">
              <StackPanel>
                  <TextBlock Text="Categor&#237;as r&#225;pidas" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,10"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                      <!-- BotÃ³n PapelerÃ­a -->
                      <Button Command="{Binding SeleccionarCategoriaCommand}" CommandParameter="Papeler&#237;a" Margin="0,0,8,0" Height="36" Cursor="Hand">
                          <Button.Template>
                              <ControlTemplate TargetType="Button">
                                  <Border x:Name="border" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16,0" Background="White">
                                      <TextBlock Text="Papeler&#237;a" Foreground="#1E293B" FontWeight="Medium" VerticalAlignment="Center"/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                      <DataTrigger Binding="{Binding DataContext.CategoriaSeleccionada, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Papeler&#237;a">
                                          <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                          <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                          <Setter Property="Foreground" Value="#2563EB"/>
                                      </DataTrigger>
                                  </ControlTemplate.Triggers>
                              </ControlTemplate>
                          </Button.Template>
                      </Button>
                      
                      <!-- BotÃ³n Oficina -->
                      <Button Command="{Binding SeleccionarCategoriaCommand}" CommandParameter="Oficina" Margin="0,0,8,0" Height="36" Cursor="Hand">
                          <Button.Template>
                              <ControlTemplate TargetType="Button">
                                  <Border x:Name="border" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16,0" Background="White">
                                      <TextBlock Text="Oficina" Foreground="#1E293B" FontWeight="Medium" VerticalAlignment="Center"/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                      <DataTrigger Binding="{Binding DataContext.CategoriaSeleccionada, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Oficina">
                                          <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                          <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                          <Setter Property="Foreground" Value="#2563EB"/>
                                      </DataTrigger>
                                  </ControlTemplate.Triggers>
                              </ControlTemplate>
                          </Button.Template>
                      </Button>
                      
                      <!-- BotÃ³n Regalos -->
                      <Button Command="{Binding SeleccionarCategoriaCommand}" CommandParameter="Regalos" Margin="0,0,8,0" Height="36" Cursor="Hand">
                          <Button.Template>
                              <ControlTemplate TargetType="Button">
                                  <Border x:Name="border" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16,0" Background="White">
                                      <TextBlock Text="Regalos" Foreground="#1E293B" FontWeight="Medium" VerticalAlignment="Center"/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                      <DataTrigger Binding="{Binding DataContext.CategoriaSeleccionada, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Regalos">
                                          <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                          <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                          <Setter Property="Foreground" Value="#2563EB"/>
                                      </DataTrigger>
                                  </ControlTemplate.Triggers>
                              </ControlTemplate>
                          </Button.Template>
                      </Button>
                      
                      <!-- BotÃ³n Servicios -->
                      <Button Command="{Binding SeleccionarCategoriaCommand}" CommandParameter="Servicios" Margin="0,0,8,0" Height="36" Cursor="Hand">
                          <Button.Template>
                              <ControlTemplate TargetType="Button">
                                  <Border x:Name="border" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="16,0" Background="White">
                                      <TextBlock Text="Servicios" Foreground="#1E293B" FontWeight="Medium" VerticalAlignment="Center"/>
                                  </Border>
                                  <ControlTemplate.Triggers>
                                      <DataTrigger Binding="{Binding DataContext.CategoriaSeleccionada, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Servicios">
                                          <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                          <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                          <Setter Property="Foreground" Value="#2563EB"/>
                                      </DataTrigger>
                                  </ControlTemplate.Triggers>
                              </ControlTemplate>
                          </Button.Template>
                      </Button>
                  </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
