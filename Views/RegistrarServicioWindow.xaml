<Window x:Class="PapeleriaDB.Views.RegistrarServicioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alta de Servicio" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif"
        Background="#F9FAFB"
        x:Name="ModalWindow">
  <Window.Resources>
    <!-- Colors -->
    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SuccessButton" Color="#10B981" />

    <Style x:Key="OutlinedButton" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SolidGreenButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource SuccessButton}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  
  <Grid Margin="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,24">
      <TextBlock Text="Nuevo Servicio" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
      <TextBlock Text="Registra un nuevo servicio en el cat&#225;logo." FontSize="14" Foreground="{StaticResource TextSecondary}" />
    </StackPanel>

    <!-- Form -->
    <StackPanel Grid.Row="1">
      <TextBlock Text="Nombre del Servicio" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
      <TextBox Tag="Ej. Engargolado Pasta Dura" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0">
          <TextBlock Text="C&#243;digo / SKU" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
          <TextBox Tag="Ej. SRV-ENG-01" Text="{Binding CodigoInterno, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Column="2">
          <TextBlock Text="Precio Unitario" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
          <TextBox Tag="0.00" Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />
        </StackPanel>
      </Grid>

      <TextBlock Text="Descripci&#243;n / Notas" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
      <TextBox Tag="Detalles del servicio..." Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" />
    </StackPanel>

    <!-- Footer Buttons -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button Style="{StaticResource OutlinedButton}" Margin="0,0,16,0" Click="CloseButton_Click">
        <TextBlock Text="Cancelar" FontSize="14" />
      </Button>
      <Button Style="{StaticResource SolidGreenButton}" Command="{Binding GuardarServicioCommand}" CommandParameter="{Binding ElementName=ModalWindow}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Guardar Servicio" FontSize="14" />
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</Window>
