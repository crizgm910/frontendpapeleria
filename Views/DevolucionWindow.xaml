<Window x:Class="PapeleriaDB.Views.DevolucionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar devolución" Width="760" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Registrar devolución" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="{Binding Folio, StringFormat=Venta {0}}" FontSize="14" Foreground="#6B7280" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="Productos y servicios vendidos" FontWeight="SemiBold" FontSize="15"/>
                    <Button Content="Devolver todo" Command="{Binding SeleccionarTodoCommand}" HorizontalAlignment="Right" Padding="14,7"/>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Lineas}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="2.4*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="TIPO" Binding="{Binding Tipo}" Width="1*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="VENDIDO" Binding="{Binding CantidadDisponible}" Width="0.8*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="DEVOLVER" Binding="{Binding CantidadDevolver, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1*"/>
                        <DataGridTextColumn Header="REEMBOLSO" Binding="{Binding Reembolso, StringFormat={}{0:C2}}" Width="1.1*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ReembolsoEstimado, StringFormat=Reembolso estimado: {0:C2}}" FontSize="18" FontWeight="Bold" Foreground="#7E22CE"/>
                <TextBlock Text="{Binding Mensaje}" Foreground="#B45309" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancelar" IsCancel="True" Padding="22,10" Margin="0,0,10,0"/>
                <Button Content="Confirmar devolución" Command="{Binding ProcesarCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Padding="24,10" Background="#7E22CE" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
