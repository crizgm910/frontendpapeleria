<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PapeleriaDB.Views.PanelResumenView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:PapeleriaDB.Models" xmlns:viewmodels="clr-namespace:PapeleriaDB.ViewModels" mc:Ignorable="d" d:DesignHeight="900" d:DesignWidth="1440" FontFamily="Segoe UI, Inter, Roboto, Arial, sans-serif">
  <UserControl.Resources>
    <!-- Colors -->
    <SolidColorBrush x:Key="BrandBlue" Color="#2563EB" />
    <SolidColorBrush x:Key="BrandBlueLight" Color="#EFF6FF" />
    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderColor" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BgLight" Color="#F9FAFB" />
    <SolidColorBrush x:Key="SuccessBg" Color="#D1FAE5" />
    <SolidColorBrush x:Key="SuccessText" Color="#059669" />
    <SolidColorBrush x:Key="WarningBg" Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarningText" Color="#D97706" />
    <SolidColorBrush x:Key="InfoBg" Color="#DBEAFE" />
    <SolidColorBrush x:Key="InfoText" Color="#2563EB" />
    <!-- Base Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="24" />
      <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <!-- Menu Button Style -->
    <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,10" Margin="12,2">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BgLight}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandBlueLight}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Status Badge Style -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Completada">
          <Setter Property="Background" Value="{StaticResource SuccessBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
          <Setter Property="Background" Value="{StaticResource WarningBg}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="En proceso">
          <Setter Property="Background" Value="{StaticResource InfoBg}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Estado}" Value="Completada">
          <Setter Property="Foreground" Value="{StaticResource SuccessText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="Pendiente">
          <Setter Property="Foreground" Value="{StaticResource WarningText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Estado}" Value="En proceso">
          <Setter Property="Foreground" Value="{StaticResource InfoText}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Simple DataGrid Style -->
    <Style x:Key="CleanDataGrid" TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="None" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="AlternatingRowBackground" Value="Transparent" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
    </Style>
    <Style x:Key="CleanDataGridColumnHeader" TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0,0,0,16" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="CleanDataGridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource BgLight}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style x:Key="CleanDataGridCell" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32">
      <!-- Header -->
      <TextBlock Text="Panel / Resumen" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
      <TextBlock Text="Resumen operativo del d&#237;a - Papeler&#237;a DB." FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,32" />
      <!-- 4 Summary Cards -->
      <UniformGrid Columns="4" Margin="0,0,0,24">
        <!-- Card 1 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,24,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" Background="{StaticResource BrandBlueLight}" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,16,0">
              <TextBlock Text="&#x1F4CA;" FontSize="20" Foreground="{StaticResource BrandBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="VENTAS DEL DÍA" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
              <TextBlock Text="$4,870.00" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
              <TextBlock Text="&#x2191; +8% vs ayer" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessText}" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- Card 2 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,24,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" Background="{StaticResource SuccessBg}" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,16,0">
              <TextBlock Text="&#x1F4B2;" FontSize="20" Foreground="{StaticResource SuccessText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="CAJA ACTIVA / CORTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
              <TextBlock Text="$2,340.00" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
              <TextBlock Text="Último corte: 13:00" FontSize="13" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- Card 3 -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,24,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" Background="{StaticResource WarningBg}" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,16,0">
              <TextBlock Text="&#x1F4C4;" FontSize="20" Foreground="{StaticResource WarningText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="SERVICIOS HOY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
              <TextBlock Text="127" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
              <TextBlock Text="Imp./Cop./Engarg." FontSize="13" Foreground="{StaticResource TextMuted}" />
            </StackPanel>
          </Grid>
        </Border>
        <!-- Card 4 -->
        <Border Style="{StaticResource CardStyle}" Margin="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="48" Height="48" Background="#FEE2E2" CornerRadius="8" VerticalAlignment="Top" Margin="0,0,16,0">
              <TextBlock Text="&#x26A0;" FontSize="20" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock Text="ALERTAS BAJO STOCK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" />
              <TextBlock Text="14" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8" />
              <TextBlock Text="&#x2192; Ver productos" FontSize="13" FontWeight="SemiBold" Foreground="#EF4444" />
            </StackPanel>
          </Grid>
        </Border>
      </UniformGrid>
      <!-- Middle Row (2/3 + 1/3) -->
      <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <!-- Ventas recientes -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,24,0" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="24">
              <TextBlock Text="Ventas recientes" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
              <TextBlock Text="Ver todas" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" HorizontalAlignment="Right" Cursor="Hand" />
            </Grid>
            <DataGrid Grid.Row="1" ItemsSource="{Binding VentasRecientes}" Style="{StaticResource CleanDataGrid}" ColumnHeaderStyle="{StaticResource CleanDataGridColumnHeader}" RowStyle="{StaticResource CleanDataGridRow}" CellStyle="{StaticResource CleanDataGridCell}" Margin="24,0,24,24">
              <DataGrid.Columns>
                <DataGridTextColumn Header="FOLIO" Binding="{Binding Folio}" Width="1.5*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource BrandBlue}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="CLIENTE" Binding="{Binding Cliente}" Width="2*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                      <Setter Property="FontWeight" Value="Medium" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="1*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="ESTADO" Width="1.5*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource StatusBadgeStyle}">
                        <TextBlock Text="{Binding Estado}" Style="{StaticResource StatusTextStyle}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=\{0:C\}}" Width="1*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                      <Setter Property="FontWeight" Value="Bold" />
                      <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
        <!-- Actividad reciente -->
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Actividad reciente" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,24" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Actividades}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="24" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Custom colored bullet / line -->
                    <!-- The bullet color is dynamically bound, but since it's an image mockup, we can use a converter if needed. Here we assume a valid brush string in Color -->
                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <Border Grid.Column="0" Width="1" Background="{StaticResource BorderColor}" HorizontalAlignment="Left" Margin="3,20,0,-20" Visibility="Visible" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Descripcion}" FontSize="14" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Tiempo}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </Grid>
      <!-- Bottom Row: Servicios del dia -->
      <Border Style="{StaticResource CardStyle}" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="24">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Servicios del día" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
              <TextBlock Text="(Impresiones, Copias, Engargolado)" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="Gestionar servicios" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrandBlue}" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" />
          </Grid>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Servicios}" Style="{StaticResource CleanDataGrid}" ColumnHeaderStyle="{StaticResource CleanDataGridColumnHeader}" RowStyle="{StaticResource CleanDataGridRow}" CellStyle="{StaticResource CleanDataGridCell}" Margin="24,0,24,24">
            <DataGrid.Columns>
              <DataGridTextColumn Header="FOLIO" Binding="{Binding Folio}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#D97706" />
                    <!-- Orangeish -->
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="TIPO DE SERVICIO" Binding="{Binding TipoServicio}" Width="2*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="Medium" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Cantidad}" Width="1*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="PRECIO UNIT." Binding="{Binding PrecioUnitario}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=\{0:C\}}" Width="1.5*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="Bold" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="HORA" Binding="{Binding Hora}" Width="1*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
