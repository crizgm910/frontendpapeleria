<Window x:Class="PapeleriaDB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PapeleriaDB.Views"
        xmlns:viewmodels="clr-namespace:PapeleriaDB.ViewModels"
        mc:Ignorable="d"
        Title="Papelería DB" Height="700" Width="1100" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ShellViewModel}">
            <views:ShellView />
        </DataTemplate>
        
        <!-- Inner pages mapped globally so ShellView's ContentControl can resolve them -->
        <DataTemplate DataType="{x:Type viewmodels:ServiciosViewModel}">
            <views:ServiciosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PanelResumenViewModel}">
            <views:PanelResumenView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InventarioViewModel}">
            <views:InventarioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:IngresoDeStockViewModel}">
            <views:IngresoDeStockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HistorialVentasViewModel}">
            <views:HistorialVentasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:NuevaVentaViewModel}">
            <views:NuevaVentaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HistorialLogsViewModel}">
            <views:HistorialLogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ConfiguracionViewModel}">
            <views:ConfiguracionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:CorteCajaViewModel}">
            <views:CorteCajaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:MovimientosCajaViewModel}">
            <views:MovimientosCajaView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentView}" />
    </Grid>
</Window>
